FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

# CUDA 12.8 is the minimum toolkit that knows how to target Blackwell (sm_120,
# e.g. RTX 50 series). `cudagl` images are deprecated, so GL/EGL libs are
# installed manually below for pyrender's headless (EGL) offscreen rendering.
ENV TZ=US/Pacific
ENV DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
        wget bzip2 ca-certificates curl git vim tmux g++ gcc build-essential cmake checkinstall gfortran \
        libjpeg8-dev libtiff5-dev pkg-config yasm libavcodec-dev libavformat-dev libswscale-dev \
        libdc1394-dev libxine2-dev libv4l-dev libgtk2.0-dev libtbb-dev libatlas-base-dev libfaac-dev \
        libmp3lame-dev libtheora-dev libvorbis-dev libxvidcore-dev libopencore-amrnb-dev libopencore-amrwb-dev \
        x264 v4l-utils libprotobuf-dev protobuf-compiler libgoogle-glog-dev libgflags-dev libgphoto2-dev \
        libhdf5-dev doxygen libflann-dev libboost-all-dev proj-data libproj-dev libyaml-cpp-dev \
        cmake-curses-gui libzmq3-dev freeglut3-dev \
        libglvnd0 libgl1 libglx0 libegl1 libgles2 libglu1-mesa \
        libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils && \
    rm -rf /var/lib/apt/lists/*

# Expose the driver's GL/EGL libs inside the container (needed for pyrender's
# EGL backend) and make pyrender skip X11 in favor of EGL.
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV PYOPENGL_PLATFORM=egl

RUN cd / && git clone https://github.com/pybind/pybind11 &&\
    cd pybind11 && git checkout v2.10.0 &&\
    mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release -DPYBIND11_INSTALL=ON -DPYBIND11_TEST=OFF &&\
    make -j"$(nproc)" && make install


RUN cd / && wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz &&\
    tar xvzf ./eigen-3.4.0.tar.gz &&\
    cd eigen-3.4.0 &&\
    mkdir build &&\
    cd build &&\
    cmake .. &&\
    make install

SHELL ["/bin/bash", "--login", "-c"]

RUN cd / && wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /miniconda.sh && \
    /bin/bash /miniconda.sh -b -p /opt/conda &&\
    ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh &&\
    echo ". /opt/conda/etc/profile.d/conda.sh" >> ~/.bashrc &&\
    /bin/bash -c "source ~/.bashrc" && \
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main &&\
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r &&\
    /opt/conda/bin/conda update -n base -c defaults conda -y &&\
    /opt/conda/bin/conda create -n my python=3.10 -y


ENV PATH $PATH:/opt/conda/envs/my/bin

RUN conda init bash &&\
    echo "conda activate my" >> ~/.bashrc

# PyTorch 2.8.0 + CUDA 12.8 wheels: the first stable PyTorch release with
# native Blackwell (sm_120) kernels. Older cu118/cu121 wheels have no sm_120
# kernels at all, regardless of what the toolkit inside the image supports.
RUN conda activate my &&\
    pip install --no-cache-dir torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

# Kaolin >=0.18.0 ships a prebuilt wheel for this exact torch/CUDA combo, so no
# source build (and no ninja/nvcc arch guesswork) is needed here.
RUN conda activate my &&\
    pip install --no-cache-dir kaolin==0.18.0 \
        -f https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.8.0_cu128.html

# pytorch3d and nvdiffrast have no prebuilt Blackwell wheels yet, so they're
# built from source against the torch already installed above. `docker build`
# has no GPU access, so torch.cuda.is_available() is False and setup.py would
# otherwise silently skip building CUDA kernels entirely -- FORCE_CUDA makes it
# build them anyway, and TORCH_CUDA_ARCH_LIST replaces the (impossible) autodetect.
ENV FORCE_CUDA=1
ENV TORCH_CUDA_ARCH_LIST="12.0"
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

RUN conda activate my &&\
    pip install --no-cache-dir ninja &&\
    pip install --no-cache-dir --no-build-isolation "git+https://github.com/facebookresearch/pytorch3d.git@stable"

RUN conda activate my &&\
    pip install --no-cache-dir --no-build-isolation "git+https://github.com/NVlabs/nvdiffrast.git"

RUN conda activate my &&\
    pip install --no-cache-dir scipy joblib scikit-learn ruamel.yaml trimesh pyyaml opencv-python imageio open3d transformations warp-lang einops kornia pyrender

ENV OPENCV_IO_ENABLE_OPENEXR=1

RUN conda activate my &&\
    pip install --no-cache-dir scikit-image meshcat webdataset omegaconf pypng roma seaborn opencv-contrib-python openpyxl wandb imgaug Ninja xlsxwriter timm albumentations xatlas rtree nodejs jupyterlab objaverse g4f ultralytics==8.0.120 pycocotools videoio numba hydra-core &&\
    conda install -y -c anaconda h5py


ENV SHELL=/bin/bash
RUN ln -sf /bin/bash /bin/sh
